{
  "name": "@bunary/auth",
  "version": "0.2.0",
  "description": "Authentication guards and helpers for Bunary - a Bun-first backend framework inspired by Laravel",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "import": "./dist/provider.js",
      "default": "./dist/provider.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "bun build ./src/index.ts ./src/provider.ts --outdir ./dist --target bun --splitting --packages external && tsc -p tsconfig.build.json",
    "test": "bun test",
    "lint": "biome check ./src ./tests",
    "format": "biome check --write ./src ./tests",
    "typecheck": "tsc --noEmit",
    "pack:check": "bun pm pack --dry-run"
  },
  "keywords": [
    "bunary",
    "bun",
    "auth",
    "authentication",
    "guards",
    "framework"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bunary-dev/auth"
  },
  "homepage": "https://github.com/bunary-dev/auth#readme",
  "bugs": {
    "url": "https://github.com/bunary-dev/auth/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "dependencies": {
    "jose": "^6.2.14"
  },
  "peerDependencies": {
    "@bunary/http": "^0.3.0",
    "@bunary/core": "^1.0.0-rc.1"
  },
  "peerDependenciesMeta": {
    "@bunary/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@bunary/core": "file:./vendor/bunary-core-1.0.0-rc.2.tgz",
    "@bunary/http": "^0.3.0",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
